# ===========================================
# Modaralist — env template
# .env.local'e kopyala ve değerleri doldur
# (Prisma CLI .env'i okur — db:push/seed icin .env'e de koymak gerekebilir)
# ===========================================

# ---------- Database (PostgreSQL — prod: Neon) ----------
# DATABASE_URL: uygulama baglantisi (Neon'da pooled: -pooler host'u)
# DIRECT_URL: migration/db push icin direkt (pooled olmayan) baglanti
DATABASE_URL=""
DIRECT_URL=""

# ---------- Auth.js ----------
# üret: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# ---------- App ----------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- PAYTR ----------
# true iken PAYTR atlanır, siparişler direkt PAID kaydedilir (geliştirme için)
PAYMENT_SIMULATION_MODE="true"
# Canlıya geçerken: PAYMENT_SIMULATION_MODE="false"
# PAYTR panelinde Bildirim URL: https://modaralist.com/api/payment/callback
PAYTR_MERCHANT_ID=""
PAYTR_MERCHANT_KEY=""
PAYTR_MERCHANT_SALT=""
# PAYTR_TEST_MODE="1" test, "0" canlı
PAYTR_TEST_MODE="1"
PAYTR_DEBUG_ON="1"
PAYTR_NO_INSTALLMENT="0"
PAYTR_MAX_INSTALLMENT="0"
PAYTR_IFRAME_V2="1"
PAYTR_IFRAME_V2_DARK="0"
PAYTR_TIMEOUT_LIMIT="30"

# ---------- Resend (e-posta) ----------
# Bos birakirsan e-postalar gonderilmez (dev'de reset URL'i console'a yazilir)
RESEND_API_KEY=""
EMAIL_FROM="Modaralist <no-reply@modaralist.com>"

# ---------- Cloudinary (gorsel yukleme / CDN) ----------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ---------- OpenAI (Seloo AI asistan + admin AI urun metni) ----------
# Bos birakirsan AI ozellikleri pasif olur (hata vermez, no-op)
OPENAI_API_KEY=""

# ---------- Cron (gunluk islerin korumasi) ----------
# /api/cron/* endpoint'leri "Authorization: Bearer <CRON_SECRET>" ister.
# Bos birakirsan cron endpoint'leri 401 doner (fail-secure).
# üret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=""

# ---------- Kargo webhook ----------
# üret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SHIPPING_WEBHOOK_SECRET=""

# ---------- Analytics (opsiyonel) ----------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_TIKTOK_PIXEL_ID=""

# ---------- Sentry (opsiyonel — hata izleme) ----------
# SENTRY_DSN bos ise Sentry devre disi (build'de sentry plugin atlanir)
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
